# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed. Do not put a real key here.

# OpenRouter API key. Create one at https://openrouter.ai/keys and set a
# spending limit of about $20 (decision D006). One key serves all five agents.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-own-key

# Optional. OpenRouter shows these on your activity page to identify the caller.
# Neither is required for the experiment to run.
OPENROUTER_APP_URL=https://github.com/your-username/your-repo
OPENROUTER_APP_TITLE=Multi-Agent Debate Dissertation
